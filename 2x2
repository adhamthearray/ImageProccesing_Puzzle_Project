import cv2
import numpy as np
import os

# ---------------- PATHS ----------------
image_folder = r"C:\puzzle_2x2"
output_folder = r"C:\output_2x2"
os.makedirs(output_folder, exist_ok=True)
pieces_folder = os.path.join(output_folder, "pieces")
os.makedirs(pieces_folder, exist_ok=True)

# ---------------- HELPER FUNCTIONS ----------------
def analyze_image(gray):
    mean_intensity = np.mean(gray)
    contrast = np.std(gray)
    laplacian_var = cv2.Laplacian(gray, cv2.CV_64F).var()
    return mean_intensity, contrast, laplacian_var

def adaptive_parameters(mean_intensity, contrast, laplacian_var):
    if laplacian_var > 150:
        d, sigmaColor, sigmaSpace = 5, 30, 30
    elif laplacian_var > 70:
        d, sigmaColor, sigmaSpace = 7, 60, 60
    else:
        d, sigmaColor, sigmaSpace = 11, 90, 90

    if mean_intensity < 90:
        blockSize, C = 15, 3
    elif mean_intensity < 140:
        blockSize, C = 11, 5
    else:
        blockSize, C = 9, 2

    if contrast < 30:
        alpha, beta = 1.8, -0.6
    elif contrast < 60:
        alpha, beta = 1.5, -0.5
    else:
        alpha, beta = 1.2, -0.3

    return d, sigmaColor, sigmaSpace, blockSize, C, alpha, beta

def unsharp_mask(image, alpha=1.5, beta=-0.5, blur_sigma=1.5):
    blurred = cv2.GaussianBlur(image, (0,0), blur_sigma)
    return cv2.addWeighted(image, alpha, blurred, beta, 0)

# ---------------- MAIN LOOP ----------------
for filename in os.listdir(image_folder):
    if not filename.lower().endswith((".jpg", ".jpeg", ".png", ".bmp")):
        continue

    path = os.path.join(image_folder, filename)
    img = cv2.imread(path)
    if img is None:
        continue

    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    gray = cv2.equalizeHist(gray)  # optional contrast boost

    mean_intensity, contrast, lap_var = analyze_image(gray)
    d, sigmaColor, sigmaSpace, blockSize, C, alpha, beta = adaptive_parameters(mean_intensity, contrast, lap_var)

    # -------- ENHANCEMENT PIPELINE --------
    denoised = cv2.bilateralFilter(gray, d, sigmaColor, sigmaSpace)
    sharpened = unsharp_mask(denoised, alpha, beta)
    enhanced = cv2.adaptiveThreshold(
        sharpened, 255,
        cv2.ADAPTIVE_THRESH_GAUSSIAN_C,
        cv2.THRESH_BINARY_INV, blockSize, C
    )
    kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (3,3))
    clean = cv2.morphologyEx(enhanced, cv2.MORPH_CLOSE, kernel, iterations=2)

    # -------- EDGE-BASED PROJECTION --------
    sobel_h = cv2.Sobel(clean, cv2.CV_64F, 0, 1, ksize=3)
    sobel_v = cv2.Sobel(clean, cv2.CV_64F, 1, 0, ksize=3)
    sobel_h = cv2.convertScaleAbs(sobel_h)
    sobel_v = cv2.convertScaleAbs(sobel_v)

    h_proj = np.sum(sobel_h, axis=1)
    v_proj = np.sum(sobel_v, axis=0)
    h_proj = cv2.GaussianBlur(h_proj.reshape(-1,1), (5,1), 0).flatten()
    v_proj = cv2.GaussianBlur(v_proj.reshape(1,-1), (1,5), 0).flatten()

    # -------- PICK CUTS WITH TOP-5 + AUTO-CENTER LOGIC --------
    center_h = clean.shape[0] // 2
    center_v = clean.shape[1] // 2

    # Top 5 strongest peaks
    h_candidates = np.argsort(h_proj)[-5:]
    v_candidates = np.argsort(v_proj)[-5:]

    # Choose closest to center
    h_peak = min(h_candidates, key=lambda x: abs(x - center_h))
    v_peak = min(v_candidates, key=lambda x: abs(x - center_v))

    # Safety margin fallback
    margin_ratio = 0.2
    margin_h = int(clean.shape[0] * margin_ratio)
    margin_v = int(clean.shape[1] * margin_ratio)

    h_cut = h_peak if margin_h <= h_peak <= clean.shape[0]-margin_h else center_h
    v_cut = v_peak if margin_v <= v_peak <= clean.shape[1]-margin_v else center_v

    # Strength validation (optional warning)
    if h_proj[h_cut] < np.mean(h_proj)*1.2 or v_proj[v_cut] < np.mean(v_proj)*1.2:
        print(f"⚠ Weak separator detected in {filename}")

    # -------- VISUALIZATION --------
    vis = img.copy()
    cv2.line(vis, (0,h_cut), (vis.shape[1],h_cut), (0,0,255),2)
    cv2.line(vis, (v_cut,0), (v_cut,vis.shape[0]), (255,0,0),2)
    cv2.imshow("Detected Separator Lines", vis)
    print("👉 Press any key to continue...")
    key = cv2.waitKey(0)
    cv2.destroyAllWindows()
    if key == 27:
        break

    # -------- SLICE EXACTLY 4 PIECES --------
    cuts = [
        (0,h_cut,0,v_cut),
        (0,h_cut,v_cut,clean.shape[1]),
        (h_cut,clean.shape[0],0,v_cut),
        (h_cut,clean.shape[0],v_cut,clean.shape[1])
    ]
    count = 0
    for y1,y2,x1,x2 in cuts:
        piece = img[y1:y2,x1:x2]
        if piece.size == 0:
            continue
        piece_path = os.path.join(pieces_folder, f"{os.path.splitext(filename)[0]}_piece_{count}.png")
        cv2.imwrite(piece_path, piece)
        count += 1

    print(f"{filename} → {count} sub-images extracted (exact 4 pieces)")

cv2.destroyAllWindows()
