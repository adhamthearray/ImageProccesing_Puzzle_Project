import cv2
import numpy as np
import os

# ---------------- PATHS ----------------
image_folder = r"C:\puzzle_4x4"
output_folder = r"C:\output_4x4"
os.makedirs(output_folder, exist_ok=True)
pieces_folder = os.path.join(output_folder, "pieces")
os.makedirs(pieces_folder, exist_ok=True)

# ---------------- HELPER FUNCTIONS ----------------
def analyze_image(gray):
    mean_intensity = np.mean(gray)
    contrast = np.std(gray)
    laplacian_var = cv2.Laplacian(gray, cv2.CV_64F).var()
    return mean_intensity, contrast, laplacian_var

def adaptive_parameters(mean_intensity, contrast, laplacian_var):
    if laplacian_var > 150:
        d, sigmaColor, sigmaSpace = 5, 30, 30
    elif laplacian_var > 70:
        d, sigmaColor, sigmaSpace = 7, 60, 60
    else:
        d, sigmaColor, sigmaSpace = 11, 90, 90

    if mean_intensity < 90:
        blockSize, C = 15, 3
    elif mean_intensity < 140:
        blockSize, C = 11, 5
    else:
        blockSize, C = 9, 2

    if contrast < 30:
        alpha, beta = 1.8, -0.6
    elif contrast < 60:
        alpha, beta = 1.5, -0.5
    else:
        alpha, beta = 1.2, -0.3

    return d, sigmaColor, sigmaSpace, blockSize, C, alpha, beta

def unsharp_mask(image, alpha=1.5, beta=-0.5, blur_sigma=1.5):
    blurred = cv2.GaussianBlur(image, (0,0), blur_sigma)
    return cv2.addWeighted(image, alpha, blurred, beta, 0)

# ---------------- MAIN LOOP ----------------
for filename in os.listdir(image_folder):
    if not filename.lower().endswith((".jpg", ".jpeg", ".png", ".bmp")):
        continue

    path = os.path.join(image_folder, filename)
    img = cv2.imread(path)
    if img is None:
        continue

    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    gray = cv2.equalizeHist(gray)

    mean_intensity, contrast, lap_var = analyze_image(gray)
    d, sigmaColor, sigmaSpace, blockSize, C, alpha, beta = adaptive_parameters(mean_intensity, contrast, lap_var)

    denoised = cv2.bilateralFilter(gray, d, sigmaColor, sigmaSpace)
    sharpened = unsharp_mask(denoised, alpha, beta)
    enhanced = cv2.adaptiveThreshold(
        sharpened, 255,
        cv2.ADAPTIVE_THRESH_GAUSSIAN_C,
        cv2.THRESH_BINARY_INV, blockSize, C
    )
    kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (3,3))
    clean = cv2.morphologyEx(enhanced, cv2.MORPH_CLOSE, kernel, iterations=2)

    # -------- EDGE PROJECTIONS --------
    sobel_h = cv2.Sobel(clean, cv2.CV_64F, 0, 1, ksize=3)
    sobel_v = cv2.Sobel(clean, cv2.CV_64F, 1, 0, ksize=3)
    sobel_h = cv2.convertScaleAbs(sobel_h)
    sobel_v = cv2.convertScaleAbs(sobel_v)

    h_proj = cv2.GaussianBlur(np.sum(sobel_h, axis=1).reshape(-1,1), (5,1), 0).flatten()
    v_proj = cv2.GaussianBlur(np.sum(sobel_v, axis=0).reshape(1,-1), (1,5), 0).flatten()

    height, width = clean.shape

    # -------- TARGET POSITIONS FOR 4x4 GRID --------
    target_h = [int(i * height / 4) for i in range(1,4)]
    target_v = [int(i * width / 4) for i in range(1,4)]

    # Find closest strong edge to each target
    h_cuts = []
    for t in target_h:
        idx = np.argmin(np.abs(np.arange(len(h_proj)) - t))
        h_cuts.append(idx)

    v_cuts = []
    for t in target_v:
        idx = np.argmin(np.abs(np.arange(len(v_proj)) - t))
        v_cuts.append(idx)

    # -------- VISUALIZE GRID --------
    vis = img.copy()
    for y in h_cuts:
        cv2.line(vis, (0,y), (width,y), (0,0,255), 1)
    for x in v_cuts:
        cv2.line(vis, (x,0), (x,height), (255,0,0), 1)

    cv2.imshow("4x4 Grid Detection", vis)
    cv2.waitKey(0)
    cv2.destroyAllWindows()

    # -------- SLICE 16 PIECES --------
    full_h = [0] + h_cuts + [height]
    full_v = [0] + v_cuts + [width]

    count = 0
    for i in range(4):
        for j in range(4):
            y1 = full_h[i]
            y2 = full_h[i+1]
            x1 = full_v[j]
            x2 = full_v[j+1]

            piece = img[y1:y2, x1:x2]
            if piece.size == 0:
                continue

            piece_path = os.path.join(
                pieces_folder,
                f"{os.path.splitext(filename)[0]}_{i}_{j}.png"
            )
            cv2.imwrite(piece_path, piece)
            count += 1

    print(f"{filename} → {count} pieces extracted (4x4 grid)")

cv2.destroyAllWindows()
