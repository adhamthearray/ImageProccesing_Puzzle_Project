import cv2
import numpy as np
import os
from matplotlib import pyplot as plt
from google.colab import files
import zipfile

def show(img, title=""):
    plt.figure(figsize=(5,5))
    if len(img.shape)==2:
        plt.imshow(img, cmap='gray')
    else:
        plt.imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
    plt.title(title)
    plt.axis('off')
    plt.show()

print("Upload a ZIP file containing 2x2 puzzle images")
uploaded = files.upload()
zip_filename = next(iter(uploaded))
extract_folder = zip_filename.replace(".zip","")
os.makedirs(extract_folder, exist_ok=True)
with zipfile.ZipFile(zip_filename, 'r') as zip_ref:
    zip_ref.extractall(extract_folder)
print("ZIP extracted to folder:", extract_folder)




def preprocess_2x2(img):
   #changing to gray scale
      gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
   #Noise Removal by Bilateral
      
      filtered = cv2.bilateralFilter(gray, d=3, sigmaColor=20, sigmaSpace=20)


   #Illumination Correction
      clahe = cv2.createCLAHE(clipLimit=3.0, tileGridSize=(8,8))
      enhanced = clahe.apply(filtered)
   #edges
      kernel = np.array([[0, -1, 0],
                   [-1, 5, -1],
                   [0, -1, 0]])

      sharpened = cv2.filter2D(enhanced, -1, kernel)
   #thresholding
      v = np.median(enhanced)
      lower = int(max(0, 0.66*v))
      upper = int(min(255, 1.33*v))
      edges = cv2.Canny(sharpened, lower, upper)
      


      return edges


for root, _, files_in_folder in os.walk(extract_folder):
    for filename in files_in_folder:
        if filename.lower().endswith((".png",".jpg",".jpeg")):
            img_path = os.path.join(root, filename)
            img = cv2.imread(img_path)

            edges = preprocess_2x2(img)
            show(edges, f"2x2 Enhanced: {filename}")
