import os
import cv2
import numpy as np
import random
from tqdm import tqdm


# ==========================================================
# HELPER FUNCTIONS
# ==========================================================
def extract_sides(img, border=5, resize=32):
    if len(img.shape) == 2:
        img = cv2.cvtColor(img, cv2.COLOR_GRAY2BGR)
    # downscale each edge
    top = cv2.resize(img[0:border, :, :], (resize, resize))
    right = cv2.resize(img[:, -border:, :], (resize, resize))
    bottom = cv2.resize(img[-border:, :, :], (resize, resize))
    left = cv2.resize(img[:, 0:border, :], (resize, resize))
    return top, right, bottom, left


def pixel_distance(e1, e2):
    e2f = np.flipud(e2)
    d1 = np.mean(np.abs(e1.astype(np.int16) - e2.astype(np.int16)))
    d2 = np.mean(np.abs(e1.astype(np.int16) - e2f.astype(np.int16)))
    return min(d1, d2)


# ==========================================================
# LOAD PIECES
# ==========================================================
def load_pieces(folder, border=5, resize=32):
    files = sorted([f for f in os.listdir(folder) if f.lower().endswith(".png")])
    pieces = []
    for idx, f in enumerate(files):
        path = os.path.join(folder, f)
        img = cv2.imread(path)
        if img is None:
            continue
        ot, or_, ob, ol = extract_sides(img, border, resize)
        pieces.append({
            "id": idx,
            "original_path": path,
            "ot": ot, "or": or_, "ob": ob, "ol": ol
        })
    return pieces


# ==========================================================
# PRECOMPUTE COMPATIBILITY MATRIX
# ==========================================================
def precompute_compatibility(pieces):
    N = len(pieces)
    comp_right = np.zeros((N, N), dtype=np.float32)
    comp_bottom = np.zeros((N, N), dtype=np.float32)
    for i in range(N):
        for j in range(N):
            if i == j:
                comp_right[i, j] = comp_bottom[i, j] = np.inf
                continue
            comp_right[i, j] = pixel_distance(pieces[i]["or"], pieces[j]["ol"])
            comp_bottom[i, j] = pixel_distance(pieces[i]["ob"], pieces[j]["ot"])
    return comp_right, comp_bottom


# ==========================================================
# GREEDY GRID PLACEMENT
# ==========================================================
def greedy_grid(pieces, comp_right, comp_bottom, N=8):
    used = set()
    grid = [[None] * N for _ in range(N)]
    grid[0][0] = pieces[0]
    used.add(0)

    # Fill first row
    for c in range(1, N):
        left_idx = grid[0][c - 1]["id"]
        candidates = [i for i in range(len(pieces)) if i not in used]
        best = min(candidates, key=lambda x: comp_right[left_idx, x])
        grid[0][c] = pieces[best]
        used.add(best)

    # Fill remaining rows
    for r in range(1, N):
        for c in range(N):
            above_idx = grid[r - 1][c]["id"]
            candidates = [i for i in range(len(pieces)) if i not in used]
            if c == 0:
                best = min(candidates, key=lambda x: comp_bottom[above_idx, x])
            else:
                left_idx = grid[r][c - 1]["id"]
                best = min(candidates, key=lambda x: comp_bottom[above_idx, x] + comp_right[left_idx, x])
            grid[r][c] = pieces[best]
            used.add(best)
    return grid


# ==========================================================
# TOTAL ERROR (for SA or evaluation)
# ==========================================================
def total_error(grid):
    N = len(grid)
    err = 0.0
    for r in range(N):
        for c in range(N):
            if c < N - 1:
                err += pixel_distance(grid[r][c]["or"], grid[r][c + 1]["ol"])
            if r < N - 1:
                err += pixel_distance(grid[r][c]["ob"], grid[r + 1][c]["ot"])
    return err


# ==========================================================
# LIGHTWEIGHT SIMULATED ANNEALING (INCREMENTAL)
# ==========================================================
def simulated_annealing(grid, max_iter=2000, T0=1.0, alpha=0.995):
    N = len(grid)
    T = T0
    best = [row[:] for row in grid]
    best_err = total_error(grid)

    for _ in range(max_iter):
        r1, c1 = random.randrange(N), random.randrange(N)
        r2, c2 = random.randrange(N), random.randrange(N)
        if (r1, c1) == (r2, c2): continue

        # swap
        grid[r1][c1], grid[r2][c2] = grid[r2][c2], grid[r1][c1]

        new_err = total_error(grid)
        delta = new_err - best_err

        if delta < 0 or random.random() < np.exp(-delta / T):
            if new_err < best_err:
                best_err = new_err
                best = [row[:] for row in grid]
        else:
            # undo swap
            grid[r1][c1], grid[r2][c2] = grid[r2][c2], grid[r1][c1]

        T *= alpha
        if T < 1e-4:
            break
    return best, best_err


# ==========================================================
# VISUALIZATION
# ==========================================================
def visualize(grid, border=5):
    N = len(grid)
    imgs = [[cv2.imread(grid[r][c]["original_path"]) for c in range(N)] for r in range(N)]
    h = max(i.shape[0] for row in imgs for i in row)
    w = max(i.shape[1] for row in imgs for i in row)
    imgs = [[cv2.resize(i, (w, h)) for i in row] for row in imgs]

    black_v = np.zeros((h, border, 3), np.uint8)
    black_h = np.zeros((border, w * N + border * (N - 1), 3), np.uint8)

    rows = []
    for r in range(N):
        row = []
        for c in range(N):
            row.append(imgs[r][c])
            if c < N - 1: row.append(black_v)
        rows.append(np.hstack(row))

    full = rows[0]
    for r in range(1, N):
        full = np.vstack([full, black_h, rows[r]])
    return full


